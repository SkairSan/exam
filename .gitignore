[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/

# Visual Studio cache/options
.vs/

# NuGet
*.nupkg
**/packages/*
!**/packages/build/

# Rider
.idea/

# OS files
Thumbs.db
.DS_Store


# Other
ConnectionString.cs