<Window x:Class="exam.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:exam"
        mc:Ignorable="d"
        Title="AuthWindow" Height="450" Width="800">
    <Grid>
        <Button x:Name="authButton" Content="Войти" HorizontalAlignment="Left" Margin="360,183,0,0" VerticalAlignment="Top" Width="120" Click="authButton_Click"/>
        <TextBox x:Name="loginTextBox" HorizontalAlignment="Left" Margin="360,137,0,0" TextWrapping="Wrap" Text="Логин" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="passwordTextBox" HorizontalAlignment="Left" Margin="360,160,0,0" TextWrapping="Wrap" Text="Пароль" VerticalAlignment="Top" Width="120"/>

    </Grid>
</Window>
