<Window x:Class="exam.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:exam"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="807">
    <Grid>
        <DataGrid x:Name="userTable" d:ItemsSource="{d:SampleData ItemCount=5}" ColumnWidth="*" AutoGenerateColumns="False" Margin="0,70,17,0">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Name}" Header="ФИО"/>
                <DataGridTextColumn Binding="{Binding Login}" Header="Логин"/>
            </DataGrid.Columns>
        </DataGrid>
        <Button x:Name="searchButton" Content="Найти" HorizontalAlignment="Left" Margin="140,39,0,0" VerticalAlignment="Top" Height="18" Click="searchButton_Click"/>
        <TextBox x:Name="searchBox" HorizontalAlignment="Left" Margin="15,39,0,0" TextWrapping="Wrap" Text="TextBox" VerticalAlignment="Top" Width="120"/>
        <Label Content="Найти по ФИО" HorizontalAlignment="Left" Margin="50,8,0,0" VerticalAlignment="Top" Width="95"/>
        <TextBlock x:Name="authTextBlock" HorizontalAlignment="Left" Margin="675,13,0,0" TextWrapping="Wrap" Text="TextBlock" VerticalAlignment="Top" Width="95"/>

    </Grid>
</Window>
